---
// The deck: one persistent audio element that survives client-side navigation,
// so a track keeps playing while you browse the rest of the site.
---

<div class="deck" id="deck" transition:persist="deck" hidden>
  <audio preload="metadata"></audio>
  <div class="deck-in">
    <button class="pp" type="button" data-deck-toggle aria-label="Play or pause">
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" fill="currentColor"></path></svg>
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z" fill="currentColor"></path></svg>
    </button>
    <div class="meta">
      <span class="label">Now playing</span>
      <a class="title" data-deck-title href="/sound">-</a>
    </div>
    <div class="bar" data-deck-bar role="slider" aria-label="Seek" tabindex="0" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span class="fill" data-deck-fill></span>
    </div>
    <span class="time mono" data-deck-time>0:00</span>
    <button class="x" type="button" data-deck-close aria-label="Stop and close player">✕</button>
  </div>
</div>

<style>
  .deck {
    position: fixed;
    left: 50%;
    bottom: 16px;
    z-index: 60;
    width: min(620px, calc(100vw - 32px));
    transform: translateX(-50%);
    background: var(--ink);
    color: var(--paper);
    border-radius: 4px;
    box-shadow: 6px 6px 0 var(--rule-soft);
    animation: rise 0.5s var(--ease);
  }

  .deck[hidden] {
    display: none;
  }

  @keyframes rise {
    from {
      transform: translate(-50%, 140%);
    }
  }

  .deck-in {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(60px, 1.3fr) auto auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.45rem 0.7rem 0.45rem 0.45rem;
  }

  .pp {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 3px;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .pp svg {
    width: 18px;
    height: 18px;
  }

  .i-pause,
  .deck.is-playing .i-play {
    display: none;
  }

  .deck.is-playing .i-pause {
    display: block;
  }

  .meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.15;
  }

  .meta .label {
    font-size: 0.6rem;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
  }

  .title {
    font-family: var(--f-serif);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-weight: 650;
    text-decoration: none;
  }

  .bar {
    position: relative;
    height: 6px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--paper) 22%, transparent);
    cursor: pointer;
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: inherit;
    background: var(--accent);
  }

  .time {
    color: color-mix(in srgb, var(--paper) 65%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .x {
    border: 0;
    background: none;
    color: color-mix(in srgb, var(--paper) 60%, transparent);
    padding: 0.4rem;
  }

  .x:hover {
    color: var(--accent);
  }

  @media (max-width: 520px) {
    .deck-in {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
    }
    .bar {
      grid-column: 1 / -1;
      grid-row: 2;
      margin: 0 0.6rem 0.4rem;
    }

  }
</style>

<script>
  type Track = { src: string; title: string; href?: string };

  const deck = document.getElementById("deck") as HTMLDivElement;
  const audio = deck.querySelector("audio") as HTMLAudioElement;
  const q = <T extends Element>(sel: string) => deck.querySelector(sel) as T;
  const titleEl = q<HTMLAnchorElement>("[data-deck-title]");
  const fill = q<HTMLSpanElement>("[data-deck-fill]");
  const bar = q<HTMLDivElement>("[data-deck-bar]");
  const timeEl = q<HTMLSpanElement>("[data-deck-time]");

  const fmt = (s: number) => {
    if (!isFinite(s)) return "0:00";
    const m = Math.floor(s / 60);
    return `${m}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
  };

  function broadcast() {
    const playing = !audio.paused && !audio.ended;
    deck.classList.toggle("is-playing", playing);
    window.dispatchEvent(
      new CustomEvent("deck:state", {
        detail: { src: audio.dataset.src ?? "", playing, time: audio.currentTime, duration: audio.duration || 0 },
      })
    );
  }

  function load(t: Track) {
    if (audio.dataset.src !== t.src) {
      audio.src = t.src;
      audio.dataset.src = t.src;
      titleEl.textContent = t.title;
      titleEl.href = t.href ?? "/sound";
    }
    deck.hidden = false;
    audio.play().catch(() => broadcast());
  }

  window.addEventListener("deck:play", (e) => {
    const t = (e as CustomEvent<Track>).detail;
    if (audio.dataset.src === t.src && !audio.paused) audio.pause();
    else load(t);
  });

  window.addEventListener("deck:seek", (e) => {
    const { src, ratio } = (e as CustomEvent<{ src: string; ratio: number }>).detail;
    if (audio.dataset.src !== src || !audio.duration) return;
    audio.currentTime = ratio * audio.duration;
  });

  window.addEventListener("deck:pause", () => audio.pause());
  window.addEventListener("deck:ping", broadcast);

  q<HTMLButtonElement>("[data-deck-toggle]").addEventListener("click", () => {
    if (audio.paused) audio.play();
    else audio.pause();
  });

  q<HTMLButtonElement>("[data-deck-close]").addEventListener("click", () => {
    audio.pause();
    deck.hidden = true;
  });

  const seek = (clientX: number) => {
    const r = bar.getBoundingClientRect();
    if (audio.duration) audio.currentTime = Math.min(1, Math.max(0, (clientX - r.left) / r.width)) * audio.duration;
  };
  bar.addEventListener("click", (e) => seek(e.clientX));
  bar.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") audio.currentTime += 5;
    if (e.key === "ArrowLeft") audio.currentTime -= 5;
  });

  audio.addEventListener("timeupdate", () => {
    const p = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
    fill.style.width = `${p}%`;
    bar.setAttribute("aria-valuenow", String(Math.round(p)));
    timeEl.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
    broadcast();
  });
  for (const ev of ["play", "pause", "ended", "loadedmetadata"]) audio.addEventListener(ev, broadcast);
</script>
