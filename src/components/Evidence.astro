---
// §3 "Evidence": the GitHub progress tracker, written up as the empirical section
// of a paper. Figures and the baseline regression table are computed at build time;
// the last column of Table 2 is re-estimated live in the browser.
import gh from "../data/github.json";
import { fit, stars, summary, WEEKDAY_ROWS, type Spec } from "../lib/ols";
import { fmtDate } from "../lib/site";

const days = gh.weeks.flat();
const counts = days.map((d) => d.count);
const weekly = gh.weeks.map((w) => w.reduce((s, d) => s + d.count, 0));
const first = new Date(days[0].date);
const last = new Date(days[days.length - 1].date);
const mon = (d: Date) => d.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

// ---------- Figure 1: daily series with a 7-day moving average ----------
const W = 1000;
const H = 300;
const P = { l: 44, r: 10, t: 10, b: 8 };
// "Nice" axis: step of 1, 2 or 5 times a power of ten, four intervals.
const raw = Math.max(...counts, 4) / 4;
const mag = 10 ** Math.floor(Math.log10(raw));
const step = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => s >= raw)!;
const yMax = step * 4;
const fx = (i: number) => P.l + (i / (days.length - 1)) * (W - P.l - P.r);
const fy = (v: number) => H - P.b - (v / yMax) * (H - P.t - P.b);
const bw = Math.max(1, (W - P.l - P.r) / days.length - 0.6);
const ma = counts.map((_, i) => {
  const s = counts.slice(Math.max(0, i - 6), i + 1);
  return s.reduce((a, b) => a + b, 0) / s.length;
});
const maPath = ma.map((v, i) => `${i ? "L" : "M"}${fx(i).toFixed(1)} ${fy(v).toFixed(1)}`).join("");
const yTicks = [0, 1, 2, 3, 4].map((k) => k * step);
const monthTicks: { i: number; label: string }[] = [];
days.forEach((d, i) => {
  if (d.date.endsWith("-01")) monthTicks.push({ i, label: new Date(d.date).toLocaleDateString("en-GB", { month: "short" }) });
});

// ---------- Figure 2: calendar heatmap ----------
const max = Math.max(...counts, 1);
const level = (c: number) => (c <= 0 ? 0 : c / max > 0.5 ? 4 : c / max > 0.25 ? 3 : c / max > 0.08 ? 2 : 1);

// ---------- Table 1: summary statistics ----------
const sDaily = summary(counts);
const sWeekly = summary(weekly);
const f2 = (v: number) => v.toFixed(2);

// ---------- Table 2: baseline specifications ----------
const specs: Spec[] = [
  { weekdays: true, trend: false, monthFE: false, lag: false },
  { weekdays: true, trend: true, monthFE: false, lag: false },
  { weekdays: true, trend: true, monthFE: true, lag: false },
  { weekdays: true, trend: true, monthFE: true, lag: true },
];
const fits = specs.map((s) => fit(days, s));
const rows = [...WEEKDAY_ROWS, "Trend (per 100 days)", "Contributions, t-1", "Constant"];
const cell = (fitIdx: number, name: string) => fits[fitIdx].coefs.find((c) => c.name === name);
const sat = cell(0, "Saturday")!;
const sun = cell(0, "Sunday")!;
const weekend = (sat.b + sun.b) / 2;

// ---------- Figure 3: languages ----------
const langMax = Math.max(...gh.languages.map((l) => l.repos));

const payload = JSON.stringify({ days, ma });
---

<section class="wrap evidence" id="data">
  <div class="sec">
    <span class="num">§3</span>
    <h2>Evidence <em>from my own commit history</em></h2>
    <a class="more" href={`https://github.com/${gh.user}`} target="_blank" rel="noopener">github/{gh.user} ↗</a>
  </div>

  <div class="paper">
    <p class="intro" data-reveal>
      Claims about productivity should come with data. Below is every public contribution I made on GitHub between {mon(first)} and {mon(last)},
      pulled from the GitHub API when this page was built, and treated the way I would treat any other dataset.
    </p>

    <aside class="referee" data-reveal>
      <b>Referee 2</b>
      The early months look suspiciously quiet. Were the authors on holiday, or writing private code? Please discuss.
    </aside>

    <div class="keys wide" data-reveal>
      <div><span class="kv" data-count={gh.total}>{gh.total}</span><span class="label">Contributions</span></div>
      <div><span class="kv" data-count={gh.activeDays}>{gh.activeDays}</span><span class="label">Active days of {days.length}</span></div>
      <div><span class="kv" data-count={gh.longest}>{gh.longest}</span><span class="label">Longest streak (days)</span></div>
      <div><span class="kv" data-count={gh.publicRepos}>{gh.publicRepos}</span><span class="label">Public repositories</span></div>
    </div>

    <figure class="fig wide f1" data-reveal>
      <div class="chart" data-fig1>
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" class="plot" aria-label="Daily GitHub contributions with a 7-day moving average">
          {yTicks.map((t) => <line class="grid" x1={P.l} x2={W - P.r} y1={fy(t)} y2={fy(t)} />)}
          {days.map((d, i) => d.count > 0 && <rect class="bar" x={fx(i) - bw / 2} y={fy(d.count)} width={bw} height={fy(0) - fy(d.count)} />)}
          <path class="ma" d={maPath} />
          <line class="axis" x1={P.l} x2={W - P.r} y1={fy(0)} y2={fy(0)} />
          {monthTicks.map((m) => <line class="axis" x1={fx(m.i)} x2={fx(m.i)} y1={fy(0)} y2={fy(0) + 5} />)}
          <line class="cross" data-cross x1="0" x2="0" y1={P.t} y2={fy(0)} />
        </svg>
        <div class="ylab mono">
          {yTicks.map((t) => <span style={`top:${(fy(t) / H) * 100}%`}>{t}</span>)}
        </div>
        <div class="xlab mono">
          {monthTicks.map((m) => <span style={`left:${(fx(m.i) / W) * 100}%`}>{m.label}</span>)}
        </div>
        <div class="tip mono" data-tip hidden></div>
      </div>
      <figcaption class="fig-cap">
        <b>Figure 1.</b> Daily public contributions (bars) and their 7-day moving average (<span class="key-ma">line</span>), {fmtDate(first)} to {
          fmtDate(last)
        }. Hover for daily values.
      </figcaption>
    </figure>


    <figure class="fig wide f2" data-reveal>
      <div class="cal-scroll">
      <div class="cal" style={`--n:${gh.weeks.length}`}>
        <div class="wd mono" aria-hidden="true"><span>Sun</span><span></span><span>Tue</span><span></span><span>Thu</span><span></span><span>Sat</span></div>
        <div class="cells" role="img" aria-label="Calendar heatmap of daily contributions">
          {
            gh.weeks.map((w, wi) =>
              w.map((d) => <span class={`c l${level(d.count)}`} style={`grid-column:${wi + 1};grid-row:${d.weekday + 1}`} title={`${fmtDate(new Date(d.date))}: ${d.count}`} />)
            )
          }
        </div>
      </div>
      </div>
      <figcaption class="fig-cap">
        <b>Figure 2.</b> The same data as a calendar, one column per week. Stronger colour means more contributions. Note the two empty rows at the top
        and bottom.
        <span class="scale mono">less <i class="c l0"></i><i class="c l1"></i><i class="c l2"></i><i class="c l3"></i><i class="c l4"></i> more</span>
      </figcaption>
    </figure>

    <div class="t1" data-reveal>
      <table class="booktabs">
        <caption><b>Table 1.</b> Summary statistics</caption>
        <thead>
          <tr><th></th><th>N</th><th>Mean</th><th>SD</th><th>Median</th><th>P90</th><th>Max</th><th>Share 0</th></tr>
        </thead>
        <tbody>
          <tr><td>Daily contributions</td><td>{sDaily.n}</td><td>{f2(sDaily.mean)}</td><td>{f2(sDaily.sd)}</td><td>{sDaily.p50}</td><td>{sDaily.p90}</td><td>{sDaily.max}</td><td>{f2(sDaily.zero)}</td></tr>
          <tr><td>Weekly contributions</td><td>{sWeekly.n}</td><td>{f2(sWeekly.mean)}</td><td>{f2(sWeekly.sd)}</td><td>{sWeekly.p50}</td><td>{sWeekly.p90}</td><td>{sWeekly.max}</td><td>{f2(sWeekly.zero)}</td></tr>
        </tbody>
      </table>
    </div>

    <p class="finding" data-reveal>
      <span class="label">Main result</span>
      Relative to a Monday, a weekend day sees <span class="hl">{Math.abs(weekend).toFixed(1)} fewer contributions</span> on average (column 1). The
      effect survives a linear trend, month fixed effects and a lagged dependent variable. I code on weekdays and rest on weekends, and now
      there are standard errors to prove it.
    </p>

    <aside class="referee r2" data-reveal>
      <b>Referee 2</b>
      Is this causal? Weekdays do not cause commits; deadlines do. The author should cluster by semester.
    </aside>

    <div class="t2 wide" data-reveal data-spec-table>
      <table class="booktabs">
        <caption>
          <b>Table 2.</b> What predicts a busy day? OLS estimates, dependent variable: daily contributions. The last column is yours: tick the
          controls and it is re-estimated in your browser.
        </caption>
        <thead>
          <tr>
            <th></th>
            {fits.map((_, i) => <th>({i + 1})</th>)}
            <th class="you">(5) Your spec</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((name) => (
              <Fragment>
                <tr class:list={{ mid: name === "Trend (per 100 days)" }}>
                  <td>{name}</td>
                  {fits.map((_, i) => {
                    const c = cell(i, name);
                    return <td>{c ? `${c.b.toFixed(2)}${stars(c.p)}` : ""}</td>;
                  })}
                  <td class="you" data-b={name} />
                </tr>
                <tr class="se">
                  <td />
                  {fits.map((_, i) => {
                    const c = cell(i, name);
                    return <td>{c ? `(${c.se.toFixed(2)})` : ""}</td>;
                  })}
                  <td class="you" data-se={name} />
                </tr>
              </Fragment>
            ))
          }
          <tr class="mid"><td>Month fixed effects</td>{fits.map((f) => <td>{f.spec.monthFE ? "Yes" : "No"}</td>)}<td class="you" data-fe /></tr>
          <tr><td>Observations</td>{fits.map((f) => <td>{f.n}</td>)}<td class="you" data-n /></tr>
          <tr><td>R²</td>{fits.map((f) => <td>{f.r2.toFixed(3)}</td>)}<td class="you" data-r2 /></tr>
        </tbody>
      </table>
      <div class="builder" role="group" aria-label="Build your own specification">
        <span class="label">Your spec:</span>
        <label><input type="checkbox" data-opt="weekdays" checked /> Weekday dummies</label>
        <label><input type="checkbox" data-opt="trend" /> Linear trend</label>
        <label><input type="checkbox" data-opt="monthFE" /> Month FE</label>
        <label><input type="checkbox" data-opt="lag" /> Lagged contributions</label>
      </div>
      <p class="fig-note">
        Monday is the omitted category. Heteroskedasticity-robust (HC1) standard errors in parentheses. * p&lt;0.1, ** p&lt;0.05, *** p&lt;0.01. Estimated
        with a 130-line OLS routine written for this page, cross-checked against R's <code>lm()</code>.
      </p>
    </div>


    <figure class="fig f3" data-reveal>
      <div class="dots">
        {
          gh.languages.map((l) => (
            <div class="dr">
              <span class="dn">{l.name.replace("Jupyter Notebook", "Jupyter")}</span>
              <span class="track">
                <i class="stem" style={`width:${(l.repos / langMax) * 100}%`} />
                <i class="dot" style={`left:${(l.repos / langMax) * 100}%;--c:${l.color ?? "var(--ink)"}`} />
              </span>
              <span class="mono dv">{l.repos}</span>
            </div>
          ))
        }
      </div>
      <figcaption class="fig-cap">
        <b>Figure 3.</b> Number of public repositories using each language. Markup languages excluded, since rendered Quarto output would otherwise
        win by a landslide.
      </figcaption>
    </figure>

    <p class="fig-note src">Data: GitHub GraphQL API, retrieved {fmtDate(new Date(gh.fetchedAt))}. Replication code: <code>scripts/fetch-github.mjs</code>.</p>
  </div>

  <script type="application/json" data-evidence set:html={payload} />
</section>

<style>
  .intro {
    font-size: 1.2rem;
    margin: 0 0 2rem;
  }

  .keys {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1.5px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 3rem;
  }

  .keys > div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1rem 1rem 0;
  }

  .keys > div + div {
    border-left: 1px solid var(--rule-soft);
    padding-left: 1rem;
  }

  .kv {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 450;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  @media (max-width: 640px) {
    .keys {
      grid-template-columns: 1fr 1fr;
    }
    .keys > div:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .keys > div:nth-child(n + 3) {
      border-top: 1px solid var(--rule-soft);
    }
  }

  .f1 {
    margin-bottom: 2.5rem;
  }

  .chart {
    position: relative;
    padding-left: 2.2rem;
    padding-bottom: 1.6rem;
  }

  .plot {
    width: 100%;
    height: clamp(200px, 26vw, 300px);
    overflow: visible;
  }

  .plot * {
    vector-effect: non-scaling-stroke;
  }

  .grid {
    stroke: var(--rule-soft);
    stroke-dasharray: 2 3;
  }

  .bar {
    fill: var(--ink);
    opacity: 0.35;
  }

  .ma {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }

  .key-ma {
    color: var(--accent);
    font-weight: 600;
  }

  .axis {
    stroke: var(--ink);
  }

  .cross {
    stroke: var(--ink);
    stroke-width: 1;
    opacity: 0;
  }

  .chart.hover .cross {
    opacity: 0.6;
  }

  .ylab {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 1.6rem;
    width: 2.2rem;
  }

  .ylab span,
  .xlab span {
    position: absolute;
    color: var(--muted);
  }

  .ylab span {
    left: 0;
    transform: translateY(-50%);
  }

  .xlab {
    position: absolute;
    inset: 0 0 0 2.2rem;
    pointer-events: none;
  }

  .xlab span {
    bottom: 0;
    transform: translateX(-50%);
  }

  .tip {
    position: absolute;
    top: 0;
    pointer-events: none;
    background: var(--ink);
    color: var(--paper);
    padding: 0.35rem 0.5rem;
    border-radius: 3px;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .f2 {
    margin-bottom: 3rem;
  }

  .cal-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .cal {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    min-width: 600px;
  }

  .wd {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    color: var(--muted);
    font-size: 0.6rem;
  }

  .wd span {
    display: flex;
    align-items: center;
  }

  .cells {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    grid-template-rows: repeat(7, auto);
    gap: 2px;
  }

  .c {
    display: block;
    aspect-ratio: 1;
    background: var(--heat-0);
    border-radius: 1px;
  }

  .l1 {
    background: var(--heat-1);
  }
  .l2 {
    background: var(--heat-2);
  }
  .l3 {
    background: var(--heat-3);
  }
  .l4 {
    background: var(--heat-4);
  }

  .scale {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-left: 0.6rem;
    color: var(--muted);
    vertical-align: middle;
  }

  .scale .c {
    width: 10px;
  }

  .t1 {
    margin-bottom: 2.5rem;
    overflow-x: auto;
  }

  .finding {
    font-size: 1.2rem;
    border-left: 2px solid var(--accent);
    padding-left: 1.2rem;
    margin: 0 0 3rem;
  }

  .finding .label {
    display: block;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .t2 {
    margin-bottom: 1rem;
    overflow-x: auto;
  }

  .t2 table {
    min-width: 640px;
  }

  .you {
    background: color-mix(in srgb, var(--hl) 45%, transparent);
  }

  th.you {
    color: var(--ink);
  }

  .you.flash {
    animation: flash 0.6s var(--ease);
  }

  @keyframes flash {
    from {
      background: var(--hl);
    }
  }

  .builder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.2rem;
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  .builder label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
  }

  .builder input {
    accent-color: var(--accent);
    width: 15px;
    height: 15px;
  }


  .f3 {
    margin-top: 2.5rem;
  }

  .dots {
    border-top: 1.5px solid var(--rule);
    border-bottom: 1.5px solid var(--rule);
    padding: 0.6rem 0;
  }

  .dr {
    display: grid;
    grid-template-columns: 7rem 1fr 2rem;
    align-items: center;
    gap: 1rem;
    padding: 0.3rem 0;
  }

  .dn {
    font-size: 0.95rem;
  }

  .track {
    position: relative;
    height: 12px;
    background: linear-gradient(var(--rule-soft), var(--rule-soft)) center / 100% 1px no-repeat;
  }

  .stem {
    position: absolute;
    left: 0;
    top: 50%;
    height: 1.5px;
    background: var(--ink);
    transform: translateY(-50%);
  }

  .dot {
    position: absolute;
    top: 50%;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--c);
    border: 1.5px solid var(--ink);
    transform: translate(-50%, -50%);
  }

  .dv {
    text-align: right;
    color: var(--muted);
  }

  .src {
    margin-top: 2rem;
  }
</style>

<script>
  import { fit, stars, WEEKDAY_ROWS, type Day, type Spec } from "../lib/ols";

  function setup() {
    const host = document.querySelector<HTMLElement>("[data-evidence]");
    const chart = document.querySelector<HTMLElement>("[data-fig1]");
    const table = document.querySelector<HTMLElement>("[data-spec-table]");
    if (!host || !chart || !table || chart.dataset.bound) return;
    chart.dataset.bound = "1";
    const { days, ma } = JSON.parse(host.textContent || "{}") as { days: Day[]; ma: number[] };

    // Figure 1 crosshair
    const svg = chart.querySelector("svg")!;
    const cross = chart.querySelector<SVGLineElement>("[data-cross]")!;
    const tip = chart.querySelector<HTMLElement>("[data-tip]")!;
    const W = 1000;
    const L = 44;
    const R = 10;
    svg.addEventListener("pointermove", (e) => {
      const r = svg.getBoundingClientRect();
      const vx = ((e.clientX - r.left) / r.width) * W;
      const i = Math.round(((vx - L) / (W - L - R)) * (days.length - 1));
      if (i < 0 || i >= days.length) return;
      const x = L + (i / (days.length - 1)) * (W - L - R);
      cross.setAttribute("x1", String(x));
      cross.setAttribute("x2", String(x));
      chart.classList.add("hover");
      const d = days[i];
      const date = new Date(d.date).toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short", year: "numeric" });
      tip.textContent = `${date} · ${d.count} · 7d avg ${ma[i].toFixed(1)}`;
      const cr = chart.getBoundingClientRect();
      const left = r.left - cr.left + (x / W) * r.width;
      tip.style.left = `${Math.min(cr.width - 110, Math.max(110, left))}px`;
      tip.hidden = false;
    });
    svg.addEventListener("pointerleave", () => {
      chart.classList.remove("hover");
      tip.hidden = true;
    });

    // Table 2, column 5: live re-estimation
    const boxes = [...table.querySelectorAll<HTMLInputElement>("[data-opt]")];
    const rows = [...WEEKDAY_ROWS, "Trend (per 100 days)", "Contributions, t-1", "Constant"];
    const flash = (el: Element) => {
      el.classList.remove("flash");
      void (el as HTMLElement).offsetWidth;
      el.classList.add("flash");
    };
    const run = () => {
      const spec = Object.fromEntries(boxes.map((b) => [b.dataset.opt, b.checked])) as unknown as Spec;
      const f = fit(days, spec);
      for (const name of rows) {
        const c = f.coefs.find((x) => x.name === name);
        const bEl = table.querySelector(`[data-b="${name}"]`)!;
        const sEl = table.querySelector(`[data-se="${name}"]`)!;
        bEl.textContent = c ? `${c.b.toFixed(2)}${stars(c.p)}` : "";
        sEl.textContent = c ? `(${c.se.toFixed(2)})` : "";
        flash(bEl);
      }
      table.querySelector("[data-fe]")!.textContent = spec.monthFE ? "Yes" : "No";
      table.querySelector("[data-n]")!.textContent = String(f.n);
      table.querySelector("[data-r2]")!.textContent = f.r2.toFixed(3);
    };
    boxes.forEach((b) => b.addEventListener("change", run));
    run();

    // Key numbers count up once when scrolled into view.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (!en.isIntersecting) continue;
          io.unobserve(en.target);
          const el = en.target as HTMLElement;
          const to = Number(el.dataset.count);
          const t0 = performance.now();
          const step = (t: number) => {
            const p = Math.min(1, (t - t0) / 1000);
            el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      },
      { threshold: 0.5 }
    );
    document.querySelectorAll("[data-count]").forEach((el) => io.observe(el));
  }

  document.addEventListener("astro:page-load", setup);
</script>
