---
import { SOCIALS } from "../lib/site";
import gh from "../data/github.json";
const year = new Date().getFullYear();
const built = new Date(gh.fetchedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<footer class="foot">
  <div class="wrap">
    <hr class="toprule" />
    <div class="grid">
      <div class="corr">
        <p class="label">Correspondence</p>
        <p class="big">
          Open to roles in <span class="hl">data science</span>, applied econometrics and analytics engineering. Comments, offers and replication
          requests are all welcome.
        </p>
      </div>
      <ul class="links">
        {
          SOCIALS.map((s) => (
            <li>
              <a href={s.href} target={s.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
                <span>{s.label}</span>
                <span class="mono h">{s.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="colophon mono">
      <span>© {year} Ö. F. Çoban. This version: {built}.</span>
      <span>Typeset in Newsreader &amp; JetBrains Mono. No cookies, no trackers.</span>
      <span>All errors are my own.</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: 7rem;
    padding-bottom: 6rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    padding-block: 2.5rem;
  }

  .big {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0.8rem 0 0;
    max-width: 26ch;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    align-self: end;
  }

  .links a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule-soft);
    text-decoration: none;
    font-size: 1.15rem;
  }

  .links .h {
    color: var(--muted);
  }

  .links a:hover .h {
    color: var(--accent);
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    color: var(--muted);
    border-top: 1px solid var(--rule-soft);
    padding-top: 1rem;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
