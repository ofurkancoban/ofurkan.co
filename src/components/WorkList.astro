---
// Projects as numbered references, each with a generated figure thumbnail.
import { thumbSvg, type ThumbStyle } from "../lib/thumb";
import { kindLabel } from "../lib/content";

interface Item {
  id: string;
  ref: number;
  data: {
    title: string;
    summary: string;
    year: number;
    kind: string;
    stack: string[];
    role: string;
    figure?: ThumbStyle | "";
    live?: string;
  };
}

const { items } = Astro.props as { items: Item[] };
---

<ol class="refs">
  {
    items.map((p) => (
      <li data-kind={p.data.kind}>
        <a href={`/work/${p.id}`} class="ref">
          <span class="n mono">[{p.ref}]</span>
          <span class="body">
            <span class="meta">
              <span class="tag">{kindLabel[p.data.kind]}</span>
              <span class="mono y">{p.data.year}</span>
              {p.data.live && <span class="mono live">● live</span>}
            </span>
            <span class="t">{p.data.title}</span>
            <span class="s">{p.data.summary}</span>
            <span class="mono st">{p.data.stack.slice(0, 5).join(" · ")}</span>
          </span>
          <span class="thumb">
            <Fragment set:html={thumbSvg(p.id, p.data.title, `Figure A.${p.ref}`, p.data.figure)} />
            <span class="mono fl">Fig. A.{p.ref}</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .refs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .refs li[hidden] {
    display: none;
  }

  .ref {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) 220px;
    column-gap: 2.5rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--rule-soft);
    text-decoration: none;
    color: inherit;
  }

  .n {
    color: var(--accent);
    font-size: 0.8rem;
    padding-top: 0.15rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .y {
    color: var(--muted);
  }

  .live {
    color: var(--green);
  }

  .t {
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.1;
    transition: color 0.15s;
  }

  .ref:hover .t {
    color: var(--accent);
  }

  .s {
    color: var(--ink-2);
    font-size: 1.02rem;
    line-height: 1.45;
    max-width: 60ch;
  }

  .st {
    color: var(--muted);
  }

  .thumb {
    position: relative;
    align-self: start;
    border: 1px solid var(--rule-soft);
    background: var(--paper);
    padding: 0.6rem 0.6rem 1.4rem;
    transition: transform 0.35s var(--ease), border-color 0.2s;
  }

  .ref:hover .thumb {
    transform: translateY(-3px) rotate(-0.6deg);
    border-color: var(--rule);
  }

  .fl {
    position: absolute;
    left: 0.6rem;
    bottom: 0.35rem;
    color: var(--muted);
  }

  @media (max-width: 1020px) {
    .ref {
      grid-template-columns: 3rem minmax(0, 1fr) 160px;
      column-gap: 1.2rem;
    }
  }

  @media (max-width: 620px) {
    .ref {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.8rem;
    }
    .n {
      display: none;
    }
    .thumb {
      grid-row: 1;
      max-width: 240px;
    }
  }
</style>
