---
import { ClientRouter } from "astro:transitions";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import Deck from "../components/Deck.astro";
import "../styles/global.css";
import serifFont from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Furkan Çoban: applied economist and data scientist in Oldenburg. Research, software, notes and data.",
  image,
} = Astro.props;

const fullTitle = title ? `${title} · Furkan Çoban` : "Furkan Çoban · Applied Economics & Data Science";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-mode="print">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="Notes" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="theme-color" content="#f6f3ec" />
    <script is:inline>
      // Pick print (light) or screen (dark) before first paint to avoid a flash.
      (function () {
        var m = null;
        try { m = localStorage.getItem("mode"); } catch (e) {}
        if (!m) m = matchMedia("(prefers-color-scheme: dark)").matches ? "screen" : "print";
        document.documentElement.dataset.mode = m;
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Deck />

    <script is:inline>
      // Keep the chosen mode across client-side navigations.
      document.addEventListener("astro:after-swap", function () {
        var m = null;
        try { m = localStorage.getItem("mode"); } catch (e) {}
        if (!m) m = matchMedia("(prefers-color-scheme: dark)").matches ? "screen" : "print";
        document.documentElement.dataset.mode = m;
      });
    </script>
    <script>
      function reveal() {
        const els = document.querySelectorAll<HTMLElement>("[data-reveal]:not(.in)");
        if (!("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("in"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener("astro:page-load", reveal);
    </script>
  </body>
</html>
