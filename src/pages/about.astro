---
import Base from "../layouts/Base.astro";
import { SOCIALS } from "../lib/site";
import { CV } from "../data/cv";
---

<Base title="About" description="About Furkan Çoban: education, methods, tools and coursework.">
  <section class="wrap">
    <header class="paper head">
      <p class="label full">About the author</p>
      <h1 class="title wide">Furkan <em>Çoban</em></h1>
    </header>

    <div class="paper">
      <div class="bio">
        <p class="lead">{CV.bio.lead}</p>
        {CV.bio.rest.map((p) => <p>{p}</p>)}
        <div class="cta">
          {CV.cvUrl && <a class="btn" href={CV.cvUrl}>Download CV (PDF)</a>}
          <a class="btn ghost" href="https://linkedin.com/in/ofurkancoban" target="_blank" rel="noopener">LinkedIn ↗</a>
        </div>
      </div>

      <aside class="referee">
        <b>Referee 2</b>
        The projects suggest an unusual tolerance for messy data. Robustness checks are pending.
      </aside>

      <section class="block">
        <h2 class="label">Education</h2>
        <table class="booktabs">
          <tbody>
            {
              CV.education.map((e) => (
                <tr>
                  <td class="when">{e.when}</td>
                  <td class="what">
                    <b>{e.what}</b>
                    <br />
                    {e.where}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      {
        CV.experience.length > 0 && (
          <section class="block">
            <h2 class="label">Experience</h2>
            <table class="booktabs">
              <tbody>
                {CV.experience.map((e) => (
                  <tr>
                    <td class="when">{e.when}</td>
                    <td class="what">
                      <b>{e.what}</b>
                      <br />
                      {e.where}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )
      }

      <section class="block">
        <h2 class="label">Methods &amp; tools</h2>
        <table class="booktabs">
          <tbody>
            {
              CV.skills.map((s) => (
                <tr>
                  <td class="when">{s.group}</td>
                  <td class="what">{s.items.join(" · ")}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <section class="block">
        <h2 class="label">Selected coursework</h2>
        <ul class="courses">{CV.coursework.map((c) => <li>{c}</li>)}</ul>
      </section>

      <section class="block">
        <h2 class="label">Elsewhere</h2>
        <ul class="courses">
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href}>{s.label}</a> <span class="mono">{s.handle}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: 2rem;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 380;
    margin-top: 1rem;
  }

  h1 em {
    font-weight: 300;
  }

  .bio {
    border-top: 1.5px solid var(--rule);
    padding-top: 1.4rem;
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .bio p {
    margin: 0 0 1em;
  }

  .bio .lead {
    font-size: 1.5rem;
    line-height: 1.35;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .block {
    margin-top: 3rem;
  }

  .block h2 {
    margin: 0 0 0.6rem;
    font-weight: 500;
  }

  .booktabs td {
    text-align: left;
    vertical-align: top;
    padding-block: 0.6rem;
    border-top: 1px solid var(--rule-soft);
  }

  .booktabs tr:first-child td {
    border-top: 1.5px solid var(--rule);
  }

  .when {
    width: 9rem;
    color: var(--accent);
  }

  .what {
    font-family: var(--f-serif);
    font-size: 1.02rem;
    line-height: 1.45;
  }

  .what b {
    font-weight: 600;
  }

  .courses {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--rule);
  }

  .courses li {
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .courses .mono {
    color: var(--muted);
    margin-left: 0.5rem;
  }
</style>
