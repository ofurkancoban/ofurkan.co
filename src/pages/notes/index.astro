---
import Base from "../../layouts/Base.astro";
import { getNotes } from "../../lib/content";
import { fmtDate, readingTime } from "../../lib/site";

const notes = await getNotes();
---

<Base title="Notes" description="Notes on econometrics, data and the tools in between, by Furkan Çoban.">
  <section class="wrap">
    <header class="paper head">
      <p class="label full">§2 · Notes · <a href="/rss.xml">RSS</a></p>
      <h1 class="title wide">Notes</h1>
      <p class="intro">Shorter pieces on econometrics, data pipelines and the tools I build. Think of them as extended footnotes.</p>
    </header>

    <ol class="list">
      {
        notes.map((p, i) => (
          <li>
            <a href={`/notes/${p.id}`}>
              <span class="mono n">2.{notes.length - i}</span>
              <span class="b">
                <span class="t">{p.data.title}</span>
                <span class="d">{p.data.description}</span>
                <span class="tags">
                  {p.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </span>
              </span>
              <span class="mono m">
                {fmtDate(p.data.date)}
                <br />
                {readingTime(p.body ?? "")} min read
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .head {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: 2rem;
    border-bottom: 1.5px solid var(--rule);
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 380;
    margin: 1rem 0 1.4rem;
  }

  .intro {
    font-size: 1.2rem;
    color: var(--ink-2);
    margin: 0;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list a {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, var(--text)) 1fr;
    column-gap: 2.5rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--rule-soft);
    text-decoration: none;
    color: inherit;
  }

  .n {
    color: var(--accent);
    padding-top: 0.4rem;
  }

  .b {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .t {
    font-size: 1.8rem;
    font-weight: 450;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .list a:hover .t {
    color: var(--accent);
  }

  .d {
    color: var(--ink-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.2rem;
  }

  .m {
    color: var(--muted);
    padding-top: 0.4rem;
  }

  @media (max-width: 1020px) {
    .list a {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.5rem;
    }
    .n {
      display: none;
    }
  }
</style>
